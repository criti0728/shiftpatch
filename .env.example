SHIFTPATCH_AI_MODE=calculation_only
SHIFTPATCH_ENV=development
SHIFTPATCH_STORAGE=sqlite
# 클라우드 프로젝트 없이 calculation_only 모드로 실행할 수 있습니다.
# scripts/dev.py는 루트의 .env를 읽습니다. 기존 환경 변수가 우선합니다.
# 모든 실행 경로(dev.py, 직접 uvicorn, 연결 확인/평가)가 이 설정을 읽습니다.
# GCP Vertex AI: 프로젝트·리전·모델을 설정하고 ADC 인증으로 사용합니다.
# SHIFTPATCH_AI_MODE=gemini
# SHIFTPATCH_GEMINI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# SHIFTPATCH_GEMINI_MODEL=gemini-3.8-flash
# 다단계 실제 모델 분석: 10~180초. 생략 시 40초, 로컬 실호출은 120초 권장.
# SHIFTPATCH_AI_TIMEOUT_SECONDS=120
# Gemini 요청당 대기 시간: 5~120초, 기본60초. 전체 분석 시간은 위 설정을 따릅니다.
# SHIFTPATCH_GEMINI_REQUEST_TIMEOUT_SECONDS=60
# 인증: gcloud auth application-default login
# SHIFTPATCH_DB_PATH=/absolute/path/to/shiftpatch.db
# 선택적 Google 로그인: Firebase Web 앱 공개 설정 (서버 비밀 키가 아닙니다).
# SHIFTPATCH_FIREBASE_API_KEY=your-firebase-web-api-key
# SHIFTPATCH_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# SHIFTPATCH_FIREBASE_APP_ID=your-firebase-web-app-id
# Cloud Run은 scripts/deploy.py가 아래 설정을 구성합니다.
# SHIFTPATCH_PUBLIC_ORIGIN=https://your-service.run.app
# SHIFTPATCH_ALLOWED_HOSTS=your-service.run.app
# SHIFTPATCH_COOKIE_SECURE=true
# SHIFTPATCH_AI_STORE_DAILY_LIMIT=10
# SHIFTPATCH_AI_GLOBAL_DAILY_LIMIT=200
# SHIFTPATCH_AI_COOLDOWN_SECONDS=60
# SHIFTPATCH_GUEST_GLOBAL_DAILY_LIMIT=1000

# Gemini Developer API: 프로젝트 없이 API 키로 로컬 검증 (키는 서버 .env에만).
# SHIFTPATCH_AI_MODE=gemini
# SHIFTPATCH_GEMINI_PROVIDER=developer
# GEMINI_API_KEY=your-api-key
# SHIFTPATCH_GEMINI_MODEL=gemini-3.8-flash
# 공식 API는 엔드포인트를 생략하면 됩니다. 프록시는 Google 네이티브 API 호환이어야 합니다.
# SHIFTPATCH_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com
# SHIFTPATCH_GEMINI_API_VERSION=v1beta
# auto는 프로젝트가 있으면 Vertex를 우선합니다. Developer 키 사용은 명시적으로 developer를 선택하세요.
# Cloud ADC 방식: SHIFTPATCH_GEMINI_PROVIDER=vertex + 위 GOOGLE_CLOUD_* 설정
# 사건 감지: 열린 점장 화면에서만 자동 분석 요청 (매 주문마다 호출하지 않음).
# SHIFTPATCH_QUEUE_THRESHOLD=5
# SHIFTPATCH_WAIT_THRESHOLD_MINUTES=10
