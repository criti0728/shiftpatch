SHIFTPATCH_AI_MODE=calculation_only
SHIFTPATCH_ENV=development
SHIFTPATCH_STORAGE=sqlite
# 클라우드 프로젝트 없이 calculation_only 모드로 실행할 수 있습니다.
# scripts/dev.py는 루트의 .env를 읽습니다. 기존 환경 변수가 우선합니다.
# 실제 Gemini 연결에만 아래 설정과 Google Cloud ADC 인증이 필요합니다.
# SHIFTPATCH_AI_MODE=gemini
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# SHIFTPATCH_GEMINI_MODEL=your-supported-model-id
# SHIFTPATCH_DB_PATH=/absolute/path/to/shiftpatch.db
# 선택적 Google 로그인: Firebase Web 앱 공개 설정 (서버 비밀 키가 아닙니다).
# SHIFTPATCH_FIREBASE_API_KEY=your-firebase-web-api-key
# SHIFTPATCH_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# SHIFTPATCH_FIREBASE_APP_ID=your-firebase-web-app-id
# Cloud Run은 scripts/deploy.py가 아래 설정을 구성합니다.
# SHIFTPATCH_PUBLIC_ORIGIN=https://your-service.run.app
# SHIFTPATCH_ALLOWED_HOSTS=your-service.run.app
# SHIFTPATCH_COOKIE_SECURE=true
# SHIFTPATCH_AI_STORE_DAILY_LIMIT=10
# SHIFTPATCH_AI_GLOBAL_DAILY_LIMIT=200
# SHIFTPATCH_AI_COOLDOWN_SECONDS=60
# SHIFTPATCH_GUEST_GLOBAL_DAILY_LIMIT=1000
